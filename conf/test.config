/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Test / stub-run profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    input              = "${projectDir}/tests/fixtures/samplesheet.csv"
    metadata           = "${projectDir}/tests/fixtures/metadata.tsv"
    outdir             = "${projectDir}/work/test-results"
    // Override S3/refdb default so -profile test stays fully offline.
    emu_db             = "${projectDir}/tests/fixtures/emu_db"
    skip_chopper                 = false
    min_length                   = 1200
    max_length                   = 1800
    min_quality                  = 10
    emu_min_abundance            = 0.0001
    emu_max_secondary            = 50
    emu_keep_read_assignments    = false
    skip_krona                   = false
    skip_phyloseq                = false
    max_cpus           = 2
    max_memory         = '4.GB'
    max_time           = '1.h'
}

process {
    executor = 'local'
    conda.enabled       = false
    docker.enabled      = false
    singularity.enabled = false
    // Cap below process_high (16/32GB) so stub-runs fit GitHub runners / local VMs.
    // Global resourceLimits in nextflow.config is bound before this profile's max_cpus.
    resourceLimits = [
        cpus  : 2,
        memory: 4.GB,
        time  : 1.h,
    ]
    beforeScript = """
    export PATH="${projectDir}/tests/stub_bin:\$PATH"
    """

    withName: NANOPLOT {
        cpus   = 2
        memory = 4.GB
    }
    withName: CHOPPER {
        cpus   = 2
        memory = 4.GB
    }
    withName: EMU_ABUNDANCE {
        cpus   = 2
        memory = 4.GB
    }
    withName: 'UNTAR|EMU_COMBINE_OUTPUTS|BUILD_PHYLOSEQ|NORMALIZE_METADATA|EMU_TO_KRONA|KRONA_PER_SAMPLE|KRONA_COMBINED|MULTIQC' {
        cpus   = 2
        memory = 4.GB
    }
}

timeline.enabled = false
report.enabled   = false
trace.enabled    = false
dag.enabled      = false
