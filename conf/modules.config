/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ttf-emu module arguments, resources, and publishDir
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    publishDir = [
        path: { "${params.outdir}/pipeline_info" },
        mode: params.publish_dir_mode,
        enabled: false
    ]

    withName: NANOPLOT {
        cpus     = 4
        memory   = 8.GB
        ext.args = { "--prefix ${meta.id}_" }
        publishDir = [
            path: { "${params.outdir}/qc/nanoplot/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.endsWith('.html') || filename.endsWith('.txt') ? filename : null
            }
        ]
    }

    withName: CHOPPER {
        cpus       = 4
        memory     = 8.GB
        ext.prefix = { "${meta.id}.chopper" }
        ext.args2  = { "--minlength ${params.min_length} --maxlength ${params.max_length} --quality ${params.min_quality}" }
        publishDir = [
            path: { "${params.outdir}/qc/chopper/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.endsWith('.log') ? filename : null
            }
        ]
    }

    withName: EMU_ABUNDANCE {
        // cpus/memory come from label process_high (16 CPUs / 32 GB); --threads uses task.cpus
        ext.args = {
            def keepAssignments = params.emu_keep_read_assignments ? '--keep-read-assignments' : ''
            "--keep-counts --min-abundance ${params.emu_min_abundance} --N ${params.emu_max_secondary} ${keepAssignments}".trim()
        }
        publishDir = [
            path: { "${params.outdir}/emu" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.endsWith('_rel-abundance.tsv') || filename.endsWith('_read-assignment-distributions.tsv') ? filename : null
            }
        ]
    }

    withName: EMU_COMBINE_OUTPUTS {
        cpus   = 2
        memory = 4.GB
        publishDir = [
            path: { "${params.outdir}/emu" },
            mode: params.publish_dir_mode,
            pattern: "emu-combined-abundance-*.tsv"
        ]
    }

    withName: BUILD_PHYLOSEQ {
        cpus   = 2
        memory = 4.GB
        publishDir = [
            path: { "${params.outdir}/phyloseq" },
            mode: params.publish_dir_mode,
            pattern: "emu_phyloseq.rds"
        ]
    }

    withName: NORMALIZE_METADATA {
        cpus   = 2
        memory = 4.GB
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: "sample_metadata.tsv"
        ]
    }

    withName: EMU_TO_KRONA {
        cpus   = 2
        memory = 4.GB
        publishDir = [ enabled: false ]
    }

    withName: KRONA_PER_SAMPLE {
        cpus       = 2
        memory     = 4.GB
        ext.prefix = { "${meta.id}.krona" }
        publishDir = [
            path: { "${params.outdir}/krona" },
            mode: params.publish_dir_mode,
            pattern: "*.html"
        ]
    }

    withName: KRONA_COMBINED {
        cpus       = 2
        memory     = 4.GB
        ext.prefix = 'krona_combined'
        publishDir = [
            path: { "${params.outdir}/krona" },
            mode: params.publish_dir_mode,
            pattern: "*.html"
        ]
    }

    withName: UNTAR {
        cpus       = 2
        memory     = 4.GB
        publishDir = [ enabled: false ]
    }

    withName: MULTIQC {
        cpus   = 2
        memory = 4.GB
        ext.prefix = 'multiqc_report'
        publishDir = [
            [
                path: { "${params.outdir}/multiqc" },
                mode: params.publish_dir_mode,
                pattern: '*multiqc_report.html'
            ],
            [
                path: { "${params.outdir}/multiqc" },
                mode: params.publish_dir_mode,
                pattern: '*_data'
            ]
        ]
    }
}
