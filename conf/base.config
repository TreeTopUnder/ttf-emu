/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ttf-emu base config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    cpus   = 1
    memory = 4.GB
    time   = 4.h

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = 4.GB
        time   = 4.h
    }
    withLabel: process_low {
        cpus   = 2
        memory = 4.GB
        time   = 4.h
    }
    withLabel: process_medium {
        cpus   = 4
        memory = 8.GB
        time   = 8.h
    }
    withLabel: process_high {
        cpus   = 8
        memory = 16.GB
        time   = 8.h
    }

    withName: NANOPLOT {
        cpus   = 4
        memory = 8.GB
        time   = 4.h
    }
    withName: CHOPPER {
        cpus   = 4
        memory = 8.GB
        time   = 4.h
    }
    withName: EMU_ABUNDANCE {
        cpus   = 4
        memory = 8.GB
        time   = 8.h
    }
    withName: 'UNTAR|EMU_COMBINE_OUTPUTS|BUILD_PHYLOSEQ|NORMALIZE_METADATA|EMU_TO_KRONA|KRONA_PER_SAMPLE|KRONA_COMBINED|MULTIQC' {
        cpus   = 2
        memory = 4.GB
        time   = 4.h
    }
}
